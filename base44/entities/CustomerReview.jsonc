{
  "name": "CustomerReview",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "blog",
        "naver_shopping",
        "coupang",
        "own_mall",
        "instagram",
        "other"
      ],
      "description": "\ud6c4\uae30 \ucc44\ub110 / \uad6c\ub9e4 \uc7a5\uc18c"
    },
    "product_id": {
      "type": "string",
      "description": "\ub300\uc0c1 \uc81c\ud488 ID"
    },
    "product_name": {
      "type": "string",
      "description": "\uc81c\ud488\uba85 (\uc870\ud68c \ud3b8\uc758\uc6a9)"
    },
    "reviewer_name": {
      "type": "string",
      "description": "\uad6c\ub9e4\uc790(\uc791\uc131\uc790)"
    },
    "reviewer_account": {
      "type": "string",
      "description": "\uad6c\ub9e4\uc790 \uc544\uc774\ub514 / \uacc4\uc815"
    },
    "order_number": {
      "type": "string",
      "description": "\uc8fc\ubb38\ubc88\ud638 (\uc911\ubcf5 \ud310\ubcc4 \ud0a4)"
    },
    "customer_phone": {
      "type": "string",
      "description": "\uad6c\ub9e4\uc790 \uc5f0\ub77d\ucc98"
    },
    "customer_address": {
      "type": "string",
      "description": "\uad6c\ub9e4\uc790 \ubc30\uc1a1\uc9c0 \uc8fc\uc18c"
    },
    "account_info": {
      "type": "string",
      "description": "\uc815\uc0b0 \uacc4\uc88c \uc815\ubcf4"
    },
    "amount": {
      "type": "number",
      "description": "\uacb0\uc81c \uae08\uc561"
    },
    "content": {
      "type": "string",
      "description": "\ud6c4\uae30 \ud14d\uc2a4\ud2b8 \ub0b4\uc6a9"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ud6c4\uae30 \uc0ac\uc9c4 URL \ubaa9\ub85d (\uc5ec\ub7ec \uc7a5 \ucca8\ubd80 \uac00\ub2a5)"
    },
    "review_url": {
      "type": "string",
      "description": "\ud6c4\uae30 \ub9c1\ud06c"
    },
    "rating": {
      "type": "number",
      "description": "\ubcc4\uc810 (1~5)"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "description": "\uac10\uc815 \ubd84\uc11d \uacb0\uacfc (AI \uc790\ub3d9)"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ud575\uc2ec \ud0a4\uc6cc\ub4dc (AI \uc790\ub3d9 \ucd94\ucd9c)"
    },
    "status": {
      "type": "string",
      "enum": [
        "unchecked",
        "checked",
        "action_needed"
      ],
      "default": "unchecked",
      "description": "\ucc98\ub9ac \uc0c1\ud0dc"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "description": "\ud6c4\uae30 \uc791\uc131\uc77c"
    }
  },
  "required": [
