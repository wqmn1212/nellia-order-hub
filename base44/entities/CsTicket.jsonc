{
  "name": "CsTicket",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "\uad00\ub828 \uc8fc\ubb38 ID"
    },
    "order_number": {
      "type": "string",
      "description": "\uc8fc\ubb38\ubc88\ud638 (\uc870\ud68c \ud3b8\uc758\uc6a9)"
    },
    "customer_name": {
      "type": "string",
      "description": "\uace0\uac1d\uba85"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "simple_change",
        "damaged",
        "wrong_delivery",
        "defective",
        "delay",
        "refund",
        "other"
      ],
      "description": "\ud074\ub808\uc784 \uc720\ud615"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "received",
      "description": "\ucc98\ub9ac \uc0c1\ud0dc"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "product_name": {
      "type": "string",
      "description": "\uad00\ub828 \uc0c1\ud488\uba85"
    },
    "channel": {
      "type": "string",
      "description": "\ud310\ub9e4 \ucc44\ub110"
    },
    "memo": {
      "type": "string",
      "description": "\uace0\uac1d \uc0c1\ub2f4 \uba54\ubaa8"
    },
    "resolution": {
      "type": "string",
      "description": "\ucc98\ub9ac \uacb0\uacfc"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\ucc98\ub9ac \uc644\ub8cc \uc77c\uc2dc"
    }
  },
  "required": [
    "claim_type",
    "status"
  ]
}